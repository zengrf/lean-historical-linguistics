{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zengrf.github.io/lean-historical-linguistics/schema/v1/dossier.schema.json",
  "title": "Historical linguistic evidence dossier v1.0.0",
  "$comment": "The $id is an identifier, not a claim that GitHub Pages is deployed. Cross-reference and normalization-chain checks are implemented in Lean.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "sources",
    "doculects",
    "meanings",
    "analyses",
    "normalization_methods",
    "choice_groups",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "doculects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doculect"
      },
      "minItems": 1
    },
    "meanings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meaning"
      },
      "minItems": 1
    },
    "analyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/analysis"
      },
      "minItems": 0
    },
    "normalization_methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      },
      "minItems": 1
    },
    "choice_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice_group"
      },
      "minItems": 0
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "version",
        "license",
        "kind",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "publication",
            "dataset",
            "synthetic"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest",
        "latest",
        "convention"
      ],
      "properties": {
        "earliest": {
          "type": "integer"
        },
        "latest": {
          "type": "integer"
        },
        "convention": {
          "const": "astronomical-year"
        }
      }
    },
    "doculect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "family",
        "stage",
        "kind",
        "date_range"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "attested",
            "proto"
          ]
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/date_range"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "source_ids",
        "proto_node_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "minItems": 1
        },
        "proto_node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "method_version",
        "input",
        "output",
        "reason"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cell": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "segment",
                "boundary",
                "unknown"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "missing",
                "gap"
              ]
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "choice_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "options",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "option_id"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "option_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original",
        "normalized",
        "cells",
        "normalization",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "original": {
          "type": "string"
        },
        "normalized": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          },
          "minItems": 1
        },
        "normalization": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 0
        }
      }
    },
    "raw_column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "import_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "table",
        "row_id",
        "id_column",
        "original_column",
        "raw_columns"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "row_id": {
          "type": "string",
          "minLength": 1
        },
        "id_column": {
          "type": "string",
          "minLength": 1
        },
        "original_column": {
          "type": "string",
          "minLength": 1
        },
        "raw_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_column"
          },
          "minItems": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "doculect_id",
        "meaning_ids",
        "representation",
        "attestation",
        "evidence_state",
        "analysis_id",
        "proto_node_id",
        "citations",
        "readings",
        "uncertain",
        "uncertainty_note",
        "imported_from"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "doculect_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "meaning_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "representation": {
          "type": "string",
          "enum": [
            "orthographic",
            "phonetic",
            "phonemic",
            "mixed"
          ]
        },
        "attestation": {
          "type": "string",
          "enum": [
            "attested",
            "reconstructed"
          ]
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "unknown"
          ]
        },
        "analysis_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "proto_node_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 1
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading"
          },
          "minItems": 1
        },
        "uncertain": {
          "type": "boolean"
        },
        "uncertainty_note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "imported_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/import_origin"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
